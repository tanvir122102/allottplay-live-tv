DATABASE_URL="postgresql://postgres:postgres@localhost:5432/live_tv?schema=public"

# Secure Admin
ADMIN_EMAIL="admin@example.com"
# Generate with: npm run admin:hash -- "your-strong-password"
ADMIN_PASSWORD_HASH="scrypt$replace_me"
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"

# Stream health monitoring
CRON_SECRET="replace-with-a-long-random-secret"
STREAM_HEALTH_TIMEOUT_MS=8000
HEALTH_CHECK_BATCH_SIZE=50
HEALTH_CHECK_CONCURRENCY=8
HEALTH_CHECK_INTERVAL_MINUTES=10

# Set true only when this deployment intentionally needs private/internal remote URLs.
ALLOW_PRIVATE_REMOTE_URLS=false
